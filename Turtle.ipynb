    "Golden Ratio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdb82d30",
   "metadata": {},
   "outputs": [],
   "source": [
    "import turtle\n",
    "\n",
    "field = turtle.Screen()\n",
    "x = turtle.Turtle()\n",
    "i = 0\n",
    "a = 1\n",
    "b = 1\n",
    "c = 0\n",
    "\n",
    "for i in range(7):\n",
    "    c = a + b\n",
    "    a = b\n",
    "    b = c\n",
    "    j = 0\n",
    "\n",
    "    for j in range(5):\n",
    "        x.forward(c * 5)\n",
    "        x.right(90)\n",
    "    \n",
    "    x.forward(c * 5)\n",
    "\n",
    "field.exitonclick()\n"
   ]
  }
